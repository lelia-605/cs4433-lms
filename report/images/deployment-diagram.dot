digraph Deployment {
  graph [rankdir=TB, fontname="Arial", fontsize=11, nodesep=0.35, ranksep=0.55, pad=0.25, bgcolor=white, compound=true];
  node  [fontname="Arial", fontsize=10];
  edge  [fontname="Arial", fontsize=9];

  subgraph cluster_school {
    label=<<b>«device»<br/>School computer</b><br/>Windows 10/11 (64-bit), 4 GB RAM, keyboard and screen>;
    labeljust=r; labelloc=t; style=solid; color="#1F3864"; penwidth=1.6; margin=14;
    subgraph cluster_ubuntu {
      label=<<b>«execution environment»</b><br/>Ubuntu 22.04 or later (WSL 2)>;
      labeljust=l; labelloc=t; style=dashed; color="#2E5597"; margin=12;
      lms    [shape=note, label=<«artifact»<br/><b>lms</b><br/>(executable, v1.1)>, style=filled, fillcolor="#F2F5FB"];
      schema [shape=note, label=<«artifact»<br/><b>schema.sql</b>>, style=filled, fillcolor="#F2F5FB"];
      db     [shape=note, label=<«artifact»<br/><b>lms.db</b><br/>(SQLite database file)>, style=filled, fillcolor="#FFF7E6"];
      libs   [shape=component, label=<«library»<br/>libsqlite3, libsodium>, style=filled, fillcolor="#F2F5FB"];
    }
  }

  subgraph cluster_github {
    label=<<b>«cloud»<br/>GitHub</b>>; labeljust=l; style=solid; color="#555555"; margin=12;
    repo [shape=note, label=<«artifact»<br/><b>cs4433-lms</b> repository<br/>tags v1.0, v1.1>];
    ci   [shape=box3d, label=<«execution environment»<br/>GitHub Actions<br/>ubuntu-latest runner>];
  }
usb [shape=box3d, label=<«device»<br/>USB drive<br/>(daily backup of lms.db)>];
  dev [shape=box3d, label=<«device»<br/>Developer laptop<br/>(WSL Ubuntu)>];

  lms -> db     [label="reads / writes\n(SQL, parameterised)"];
  lms -> schema [label="runs on first start", style=dashed];
  lms -> libs   [label="links", style=dashed];
  db  -> usb    [label="copied by\ntechnician", style=dashed];
  dev -> repo   [label="git push (HTTPS)"];
  repo -> ci    [label="every push:\nbuild, test, cppcheck"];
  repo -> lms   [label="git clone v1.1 (HTTPS)\nduring installation only", style=dashed, lhead=cluster_school];
}
